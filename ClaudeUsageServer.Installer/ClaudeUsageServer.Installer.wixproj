<Project Sdk="WixToolset.Sdk/4.0.5">
  <PropertyGroup>
    <OutputName>ClaudeUsageServer</OutputName>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!--
      Path to dotnet publish output.
      Run: dotnet publish ../ClaudeUsageServer.csproj -c Release -r win-x64 -o ../publish/
      Override at build time: dotnet build -p:PublishDir=C:\my\path\
    -->
    <PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\</PublishDir>
    <!-- Expose PublishDir to the WiX preprocessor as $(var.PublishDir). -->
    <DefineConstants>PublishDir=$(PublishDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="4.0.5" />
  </ItemGroup>
</Project>
