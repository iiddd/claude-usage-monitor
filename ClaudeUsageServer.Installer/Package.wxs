<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <!--
    ClaudeUsageServer installer — WiX v4 SDK-style, x64, per-machine.

    Service account : LocalSystem
      Running as the interactive user requires knowing their password, which breaks
      one-click install for Microsoft accounts and domain accounts. LocalSystem is
      reliable. The deferred custom action CA_WriteUserPaths records the installing
      user's %USERPROFILE% and %APPDATA% (captured in the UI sequence while running
      as the user, before UAC elevation) and writes them into appsettings.json so the
      service can locate credentials and the Claude CLI.

    Log directory   : %ProgramData%\ClaudeUsageServer\logs\
      Program Files is read-only for non-admin processes at runtime.

    Upgrade policy  : Major upgrade (stable UpgradeCode, new ProductCode per version).
      appsettings.json is overwritten on upgrade — use env-var overrides
      (ClaudeUsageServer__CredentialsPath, etc.) if you need to preserve settings.

    Uninstall behaviour (deliberate choices):
      REMOVED  : All files under %ProgramFiles%\ClaudeUsageServer\
      REMOVED  : The %ProgramFiles%\ClaudeUsageServer\ directory itself (via RemoveFolder)
      REMOVED  : Windows Service registration (ServiceControl Remove="uninstall")
      REMOVED  : Event Log source registry key (RemoveRegistryKey on EventLogSourceComponent)
      KEPT     : %ProgramData%\ClaudeUsageServer\logs\ and its log files
                 Rationale: preserve diagnostic history across accidental uninstall/reinstall.
                 Delete manually if a full wipe is needed:
                   Remove-Item -Recurse -Force "$env:ProgramData\ClaudeUsageServer"
  -->

  <Package Name="Claude Usage Monitor"
           Manufacturer="Andrey Merkulov"
           Version="1.1.2"
           UpgradeCode="B8C9D0E1-F2A3-4567-2345-67890ABCDEF0"
           Language="1033"
           Codepage="1252"
           Scope="perMachine">

    <!-- Clean major-upgrade: remove old then install new in the same transaction. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!-- Single embedded CAB; produces a self-contained MSI. -->
    <MediaTemplate EmbedCab="yes" />

    <!-- ── Directory structure ─────────────────────────────────────────────── -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ClaudeUsageServer" />
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="PROGRAMDATADIR" Name="ClaudeUsageServer">
        <Directory Id="LOGSDIR" Name="logs" />
      </Directory>
    </StandardDirectory>

    <!-- ── Components ──────────────────────────────────────────────────────── -->

    <!--
      Main executable + Windows Service registration.
      ServiceInstall/ServiceControl must live in the same component as the exe KeyPath.
    -->
    <Component Id="MainExeComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MainExeFile"
            Source="$(var.PublishDir)ClaudeUsageServer.exe"
            KeyPath="yes" />
      <ServiceInstall Id="ServiceInstall"
                      Name="ClaudeUsageServer"
                      DisplayName="Claude Usage Monitor"
                      Description="Proxies Claude Code OAuth usage data to the iCUE widget."
                      Type="ownProcess"
                      Start="auto"
                      Account="LocalSystem"
                      ErrorControl="normal" />
      <ServiceControl Id="ServiceControl"
                      Name="ClaudeUsageServer"
                      Start="install"
                      Stop="both"
                      Remove="uninstall"
                      Wait="yes" />
      <!--
        RemoveFolder schedules INSTALLFOLDER for deletion on uninstall via the RemoveFolders
        standard action. MSI only deletes the directory if it is empty at that point — all
        File components above are removed first, so the directory will be empty. Without this
        element the directory is left behind even after all files inside it are gone.
      -->
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- appsettings.json: separate component so the CA_WriteUserPaths action can update it. -->
    <Component Id="AppConfigComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="AppSettingsJson"
            Source="$(var.PublishDir)appsettings.json"
            KeyPath="yes" />
    </Component>

    <!-- Application assembly and runtime manifest files. -->
    <Component Id="AppDllComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="AppDll" Source="$(var.PublishDir)ClaudeUsageServer.dll" KeyPath="yes" />
    </Component>
    <Component Id="AppDepsComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="AppDeps" Source="$(var.PublishDir)ClaudeUsageServer.deps.json" KeyPath="yes" />
    </Component>
    <Component Id="AppRuntimeConfigComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="AppRuntimeConfig" Source="$(var.PublishDir)ClaudeUsageServer.runtimeconfig.json" KeyPath="yes" />
    </Component>

    <!-- Serilog and related logging DLLs. -->
    <Component Id="SerilogComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="Serilog" Source="$(var.PublishDir)Serilog.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogAspNetCoreComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogAspNetCore" Source="$(var.PublishDir)Serilog.AspNetCore.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogExtHostingComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogExtHosting" Source="$(var.PublishDir)Serilog.Extensions.Hosting.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogExtLoggingComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogExtLogging" Source="$(var.PublishDir)Serilog.Extensions.Logging.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogFmtCompactComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogFmtCompact" Source="$(var.PublishDir)Serilog.Formatting.Compact.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogSettingsCfgComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogSettingsCfg" Source="$(var.PublishDir)Serilog.Settings.Configuration.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogSinkConsoleComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogSinkConsole" Source="$(var.PublishDir)Serilog.Sinks.Console.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogSinkDebugComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogSinkDebug" Source="$(var.PublishDir)Serilog.Sinks.Debug.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogSinkEventLogComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogSinkEventLog" Source="$(var.PublishDir)Serilog.Sinks.EventLog.dll" KeyPath="yes" />
    </Component>
    <Component Id="SerilogSinkFileComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SerilogSinkFile" Source="$(var.PublishDir)Serilog.Sinks.File.dll" KeyPath="yes" />
    </Component>

    <!-- .NET runtime support DLLs. -->
    <Component Id="MsExtDependencyModelComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MsExtDependencyModel" Source="$(var.PublishDir)Microsoft.Extensions.DependencyModel.dll" KeyPath="yes" />
    </Component>
    <Component Id="MsExtWinServicesComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="MsExtWinServices" Source="$(var.PublishDir)Microsoft.Extensions.Hosting.WindowsServices.dll" KeyPath="yes" />
    </Component>
    <Component Id="SvcControllerComponent" Directory="INSTALLFOLDER" Guid="*">
      <File Id="SvcController" Source="$(var.PublishDir)System.ServiceProcess.ServiceController.dll" KeyPath="yes" />
    </Component>

    <!-- Create %ProgramData%\ClaudeUsageServer\logs\ on install, remove on uninstall. -->
    <!-- Explicit GUID required: Guid="*" is unsupported for directory-keyed components. -->
    <Component Id="ProgramDataLogsDir" Directory="LOGSDIR" Guid="F1A2B3C4-D5E6-7890-F1A2-B3C4D5E67890">
      <CreateFolder />
    </Component>

    <!--
      Write the installing user's credential and CLI paths into the service's environment
      registry entry. The Windows SCM reads the REG_MULTI_SZ value at
      HKLM\...\Services\ClaudeUsageServer\Environment and injects those KEY=VALUE pairs
      into the service process environment at every startup. The .NET configuration system
      then picks up ClaudeUsageServer__* env vars as overrides for the matching appsettings
      keys — no modification of appsettings.json required.

      [%USERPROFILE] and [%APPDATA] are MSI environment-variable references; they expand
      to the installing user's profile paths during WriteRegistryValues, which runs in the
      elevated-but-user-context UAC execute session (standard UAC elevation preserves
      USERPROFILE/APPDATA from the original user token).

      Timing: WriteRegistryValues (sequence 5000) runs before InstallServices (5800).
      The Win32 CreateService() call writes only its own values (Type, Start, ImagePath …)
      to the service key and does not touch existing values, so Environment survives.

      Uninstall: DeleteServices (sequence 2000) removes the entire service key including
      the Environment value. RemoveRegistryValues (2600) then cleans up the SOFTWARE
      tracking key used as this component's KeyPath.
    -->
    <Component Id="ServiceEnvComponent" Directory="INSTALLFOLDER" Guid="*">
      <!-- Stable HKLM\SOFTWARE KeyPath for MSI component tracking, separate from the
           service key which is owned and deleted by the SCM on DeleteServices. -->
      <RegistryValue Id="ServiceEnvMarker"
                     Root="HKLM"
                     Key="SOFTWARE\ClaudeUsageServer"
                     Name="Installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <!-- KEY=VALUE pair injected by the SCM into the service process at startup. -->
      <RegistryValue Id="ServiceEnvironment"
                     Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\ClaudeUsageServer"
                     Name="Environment"
                     Type="multiString"
                     Value="ClaudeUsageServer__CredentialsPath=[%USERPROFILE]\.claude\.credentials.json" />
      <!-- Remove the SOFTWARE\ClaudeUsageServer key on uninstall (the service key is
           removed by DeleteServices which runs earlier in the sequence). -->
      <RemoveRegistryKey Id="RemoveServiceSoftwareKey"
                         Root="HKLM"
                         Key="SOFTWARE\ClaudeUsageServer"
                         Action="removeOnUninstall" />
    </Component>

    <!--
      Register the Windows Event Log source so Serilog's EventLog sink can write
      without needing a custom message DLL. EventCreate.exe is a standard Windows
      tool; using it as the EventMessageFile is a well-known workaround that lets
      the service write plain-text entries without shipping a resource DLL.

      RemoveRegistryKey ensures the entire HKLM key is deleted on uninstall, not
      just the EventMessageFile value. The Windows Event Log subsystem may have added
      extra values (TypesSupported, CategoryCount) to the same key at runtime; without
      RemoveRegistryKey, those system-written values prevent the key from being removed
      by the standard RemoveRegistryValues action, leaving a stale key in the registry.
    -->
    <Component Id="EventLogSourceComponent" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Id="EventLogSourceKey"
                     Root="HKLM"
                     Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\ClaudeUsageServer"
                     Name="EventMessageFile"
                     Value="%SystemRoot%\System32\EventCreate.exe"
                     Type="expandable"
                     KeyPath="yes" />
      <RemoveRegistryKey Id="RemoveEventLogKey"
                         Root="HKLM"
                         Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\ClaudeUsageServer"
                         Action="removeOnUninstall" />
    </Component>

    <!-- ── Features ────────────────────────────────────────────────────────── -->

    <Feature Id="Complete" Title="Claude Usage Monitor" Level="1">
      <ComponentRef Id="MainExeComponent" />
      <ComponentRef Id="AppConfigComponent" />
      <ComponentRef Id="AppDllComponent" />
      <ComponentRef Id="AppDepsComponent" />
      <ComponentRef Id="AppRuntimeConfigComponent" />
      <ComponentRef Id="SerilogComponent" />
      <ComponentRef Id="SerilogAspNetCoreComponent" />
      <ComponentRef Id="SerilogExtHostingComponent" />
      <ComponentRef Id="SerilogExtLoggingComponent" />
      <ComponentRef Id="SerilogFmtCompactComponent" />
      <ComponentRef Id="SerilogSettingsCfgComponent" />
      <ComponentRef Id="SerilogSinkConsoleComponent" />
      <ComponentRef Id="SerilogSinkDebugComponent" />
      <ComponentRef Id="SerilogSinkEventLogComponent" />
      <ComponentRef Id="SerilogSinkFileComponent" />
      <ComponentRef Id="MsExtDependencyModelComponent" />
      <ComponentRef Id="MsExtWinServicesComponent" />
      <ComponentRef Id="SvcControllerComponent" />
      <ComponentRef Id="ProgramDataLogsDir" />
      <ComponentRef Id="EventLogSourceComponent" />
      <ComponentRef Id="ServiceEnvComponent" />
    </Feature>

  </Package>

</Wix>
